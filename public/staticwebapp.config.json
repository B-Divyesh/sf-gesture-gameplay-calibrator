{
  "responseOverrides": {
    "404": { "rewrite": "/404.html" }
  },
  "globalHeaders": {
    "Content-Security-Policy": "default-src 'self'; base-uri 'self'; connect-src 'self' https://api.sociobot.in https://pilot-api.sociobot.in; img-src 'self' blob:; media-src 'self' blob:; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; worker-src 'self'; manifest-src 'self'",
    "Permissions-Policy": "camera=(self), geolocation=(), microphone=(), payment=(), usb=()",
    "Referrer-Policy": "strict-origin-when-cross-origin",
    "X-Content-Type-Options": "nosniff",
    "X-Frame-Options": "DENY"
  },
  "mimeTypes": {
    ".webmanifest": "application/manifest+json"
  },
  "routes": [
    { "route": "/assets/*", "headers": { "Cache-Control": "public, max-age=31536000, immutable" } },
    { "route": "/icons/*", "headers": { "Cache-Control": "public, max-age=31536000, immutable" } },
    { "route": "/demo", "rewrite": "/demo/index.html", "headers": { "Cache-Control": "no-cache, no-store, must-revalidate" } },
    { "route": "/demo/*", "headers": { "Cache-Control": "no-cache, no-store, must-revalidate" } },
    { "route": "/", "headers": { "Cache-Control": "no-cache, no-store, must-revalidate" } },
    { "route": "/privacy/*", "headers": { "Cache-Control": "no-cache, no-store, must-revalidate" } },
    { "route": "/terms/*", "headers": { "Cache-Control": "no-cache, no-store, must-revalidate" } },
    { "route": "/sw.js", "headers": { "Cache-Control": "no-cache, no-store, must-revalidate" } },
    { "route": "/manifest.webmanifest", "headers": { "Cache-Control": "no-cache, no-store, must-revalidate" } }
  ]
}
